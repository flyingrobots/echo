package consumer.closures.program@1;
use lawpack consumer.closures@1 digest "sha256:f456781ccd9693b42136e7a0c5f711bd4f2f77e0dcb5820125e1041a4290ebea" as fx;
type Candidate = { guide: fx.Guide, depth: U64, slot: U64, parent: fx.NodeRow, child: fx.NodeRow };
type Decision = { expand: Bool, guide: fx.Guide, wellFormed: Bool, sufficient: Bool };
fn select(candidate: Candidate) -> Decision {
  let followA = if candidate.guide.followA == true && candidate.slot == 0u64 then true else false;
  let followB = if candidate.guide.followB == true && candidate.slot == 1u64 then true else false;
  let next: fx.Guide = { a: candidate.guide.a, b: candidate.guide.b, followA: followA, followB: followB, reach: candidate.guide.reach };
  let expand = if followA == true || followB == true then true else false;
  let sufficient = if expand == true && candidate.depth > candidate.guide.reach then false else true;
  let wellFormed = true;
  return { expand: expand, guide: next, wellFormed: wellFormed, sufficient: sufficient };
}
fn costly(candidate: Candidate) -> Decision {
  let a1 = if candidate.guide.followA == true && candidate.slot == 0u64 then true else false;
  let a2 = if a1 == true && candidate.depth > candidate.guide.a then true else false;
  let a3 = if a2 == true && candidate.depth > candidate.guide.b then true else false;
  let a4 = if a3 == true && candidate.slot > candidate.guide.reach then true else false;
  let b1 = if candidate.guide.followB == true && candidate.slot == 1u64 then true else false;
  let b2 = if b1 == true && candidate.depth > candidate.guide.a then true else false;
  let b3 = if b2 == true && candidate.depth > candidate.guide.b then true else false;
  let b4 = if b3 == true && candidate.slot > candidate.guide.reach then true else false;
  let next: fx.Guide = { a: candidate.guide.a, b: candidate.guide.b, followA: a4, followB: b4, reach: candidate.guide.reach };
  let again: fx.Guide = { a: next.a, b: next.b, followA: next.followA, followB: next.followB, reach: next.reach };
  let expand = if a4 == true || b4 == true then true else false;
  return { expand: expand, guide: again, wellFormed: true, sufficient: true };
}
type Input = { anchor: Bytes<exact=32>, read: fx.ClosureQuery };
intent readClosure(input: Input) returns fx.Closure
  profile fx.graphEffects
  basis input.anchor
  budget <= fx.budget
{
  let observed: fx.Closure = fx.closure(input.read)
    else {
      startMissing(query) => fx.StartMissing,
      nodeBound(query) => fx.NodeBoundExceeded,
      depthBound(query) => fx.DepthBoundExceeded,
      scanBound(query) => fx.ScanBoundExceeded,
      workBound(query) => fx.WorkBoundExceeded,
      selectorInsufficient(query) => fx.SelectorInsufficient,
      storageMalformed(query) => fx.StorageMalformed,
    };
  return observed;
}
