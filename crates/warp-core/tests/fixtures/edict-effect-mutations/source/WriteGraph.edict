package consumer.writes.program@1;
use lawpack consumer.writes@1 digest "sha256:92b4827def91b37d4091d16d3b33f2ace7924ce0094e2e2b2bd8153b8826de44" as fx;
type Input = { anchor: Bytes<exact=32>, node: fx.NodeWrite, created: fx.NodeWrite, atom: fx.AtomReplace, edge: fx.EdgeWrite, retarget: fx.EdgeReplace };
intent write(input: Input) returns fx.Written
  profile fx.graphEffects
  basis input.anchor
  budget <= fx.budget
{
  let ensured: fx.Written = fx.ensureNode(input.node);
  let created: fx.Written = fx.createNode(input.created);
  let replaced: fx.Written = fx.replaceAtom(input.atom);
  let linked: fx.Written = fx.ensureEdge(input.edge);
  let retargeted: fx.Written = fx.replaceEdge(input.retarget);
  return retargeted;
}
