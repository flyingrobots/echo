package consumer.ordered.program@1;
use lawpack consumer.ordered@1 digest "sha256:a64f01904dfd2cb22ecc5182fe7b808c1f677e4b58f7c87ccb92c632e6ad0874" as fx;

failure First;
failure Second;

type Pair = { a: U64, z: U64 };

type Input = {
  anchor: Bytes<exact=32>,
  node: fx.NodeWrite,
};

fn pair() -> Pair fails First, Second {
  return { z: fail First, a: fail Second };
}

intent order(input: Input) returns fx.Written
  profile fx.graphEffects
  basis input.anchor
  budget <= fx.budget
{
  let fields: Pair = pair() else {
    First => fx.FirstRaised,
    Second => fx.SecondRaised,
  };
  let seeded: fx.Written = fx.ensureNode(input.node);
  return seeded;
}
