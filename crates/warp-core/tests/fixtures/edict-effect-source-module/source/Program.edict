package consumer.identity.program@1;
use lawpack consumer.identity@1 digest "sha256:5a977b6719a7d821ce2a2c709bc658677b0fa76e3b66441b94bb53106cc0722b" as fx;
use module jedit.probe.leaf@1 digest "sha256:83ed90b98bb9664113594df65170ae875082e3c03ef60f267083fcada56d890b" as leaf;
type Input = { w: Bytes<exact=32>, v: U64 }; type Output = { b: U64 };
intent go(input: Input) returns Output profile fx.graphEffects basis none budget <= fx.budget {
let written: fx.Written = fx.ensureNode({ atomBytes: b"", atomType: input.w, nodeId: input.w, nodeType: input.w, warpId: input.w });
let b = leaf.same(input.v);
return { b };
}
