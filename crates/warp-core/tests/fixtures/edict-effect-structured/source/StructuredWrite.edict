package consumer.structured.program@1;
use lawpack consumer.structured@1 digest "sha256:ca608b32db9e2e8f43854a202ef453e82ed4936ca569ca19cb8196dfa061ea94" as fx;

type Item = { create: Bool, node: fx.NodeWrite };
type Input = {
  anchor: Bytes<exact=32>,
  initial: fx.NodeWrite,
  items: List<Item, max=2>,
};

intent structured(input: Input) returns fx.Written
  profile fx.graphEffects
  basis input.anchor
  budget <= fx.budget
{
  let seeded: fx.Written = fx.ensureNode(input.initial);
  for item in input.items bounded 2 {
    if item.create {
      let created: fx.Written = fx.createNode(item.node);
    } else {
      let ensured: fx.Written = fx.ensureNode(item.node);
    }
  }
  return seeded;
}
