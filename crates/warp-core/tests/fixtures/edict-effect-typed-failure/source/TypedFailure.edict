package consumer.typedfail.program@1;
use lawpack consumer.typedfail@1 digest "sha256:14e3103610e66f0002360d0d7e2e7a0f5b9148290343935522a97a658a1277d7" as fx;

failure Underflow;

type Input = {
  anchor: Bytes<exact=32>,
  start: U64,
  end: U64,
  node: fx.NodeWrite,
};

fn distance(start: U64, end: U64) -> U64 fails Underflow {
  return if start <= end then end - start else fail Underflow;
}

intent measure(input: Input) returns fx.Written
  profile fx.graphEffects
  basis input.anchor
  budget <= fx.budget
{
  let span: U64 = distance(input.start, input.end) else fx.RangeInverted;
  let seeded: fx.Written = fx.ensureNode(input.node);
  return seeded;
}
